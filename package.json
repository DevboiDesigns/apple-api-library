{
  "name": "apple-api-library",
  "version": "2.0.0-beta.1",
  "description": "A TypeScript library for Apple App Store Connect API and App Store Server API (StoreKit): beta testers, subscription verification, and App Store Server Notifications V2.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DevboiDesigns/apple-api-library.git"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "release": "npm run build && npm publish",
    "release:beta": "npm run build && npm publish --tag beta"
  },
  "author": "Christopher Hicks",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.9",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "jwk-to-pem": "^2.0.5"
  },
  "peerDependencies": {
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "jsonwebtoken": "^9.0.2"
  },
  "keywords": [
    "apple",
    "app store connect",
    "storekit",
    "app store server api",
    "subscription",
    "in-app purchase",
    "notifications",
    "api",
    "library",
    "typescript"
  ]
}
