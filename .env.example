# =============================================================================
# Apple App Store Connect & App Store Server API (StoreKit)
# =============================================================================
# Copy this file to .env or .env.production / .env.development
# Never commit .env files or .p8 keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Local Development
# -----------------------------------------------------------------------------
# Set to "true" to read private keys from file paths instead of env content.
# In production, use key content (e.g. from secret manager) and leave unset.
APP_IS_LOCAL=

# -----------------------------------------------------------------------------
# App Store Connect API (apps, beta testers)
# -----------------------------------------------------------------------------
APP_STORE_ISSUER_ID=
APP_STORE_BUNDLE_ID=
APP_APPLE_ID=
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_KEY=

# -----------------------------------------------------------------------------
# App Store Server API / StoreKit (subscription verification, notifications)
# -----------------------------------------------------------------------------
APP_STORE_KIT_KEY_ID=
APP_STORE_KIT_KEY=

# -----------------------------------------------------------------------------
# Alternative names (package supports both APP_STORE_* and APPLE_*)
# -----------------------------------------------------------------------------
# APPLE_KEY_ID=
# APPLE_ISSUER_ID=
# APPLE_APP_BUNDLE_ID=
# APPLE_PRIVATE_KEY_PATH=

# -----------------------------------------------------------------------------
# Value format
# -----------------------------------------------------------------------------
# - Connect/StoreKit keys: path to .p8 file (when APP_IS_LOCAL=true)
#   OR full key content (production) e.g. "-----BEGIN PRIVATE KEY-----\n..."
# - Issuer ID: from App Store Connect → Users and Access → Keys
# - Bundle ID: e.g. com.yourcompany.yourapp
# - App Apple ID: numeric ID from App Store Connect
